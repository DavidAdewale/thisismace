# Server-only MailerLite credentials. Never prefix these with NEXT_PUBLIC_.
MAILERLITE_API_TOKEN=
MAILERLITE_GROUP_ID=
# Optional comma-separated keys. Create matching Text fields in MailerLite first.
MAILERLITE_ATTRIBUTION_FIELDS=

# Optional browser tracking IDs. Each provider is enabled independently.
NEXT_PUBLIC_GA4_MEASUREMENT_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_TIKTOK_PIXEL_ID=
NEXT_PUBLIC_TRACKING_HOSTS=thisismace.com,www.thisismace.com
# Use test provider IDs before enabling on localhost or staging.
NEXT_PUBLIC_ENABLE_LOCAL_TRACKING=false

# Ditto provides this after WBDG passes checks and is accepted by stores.
NEXT_PUBLIC_DITTO_PRESAVE_URL=
RELEASE_SPOTIFY_URL=
RELEASE_APPLE_MUSIC_URL=
RELEASE_AUDIOMACK_URL=
RELEASE_YOUTUBE_URL=

# Campaign used by /ig, /tt, /x, /yt and /snap.
SOCIAL_BIO_CAMPAIGN=artist_warmup
